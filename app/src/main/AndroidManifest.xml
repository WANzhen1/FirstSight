<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- 权限声明 -->
  <!-- 电话权限 -->
  <uses-feature android:name="android.hardware.telephony" android:required="false"/>
  <uses-permission android:name="android.permission.CALL_PHONE" />

  <!-- 联系人权限 -->
  <uses-permission android:name="android.permission.READ_CONTACTS" />

  <!-- 相机权限 -->
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <uses-permission android:name="android.permission.CAMERA" />

  <!-- 通知与开机重新排期（提醒功能） -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- 位置权限（用于天气） -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

  <!-- 网络权限 -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- 忽略电池优化 -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <!-- 应用列表权限 -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
                   tools:ignore="QueryAllPackagesPermission" />
  
  <!-- 小米系统获取应用列表权限 -->
  <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />

  <application
    android:name=".FirstSightApp"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.FirstSight"
    tools:targetApi="31">

    <!-- 主Activity - 作为Launcher -->
    <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="user"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi">

      <!-- Launcher Intent Filter -->
      <intent-filter android:priority="1000">
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.HOME" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- 首次启动权限引导 -->
    <activity
            android:name=".ui.activity.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 设置Activity -->
    <activity
            android:name=".ui.activity.SettingsActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 联系人管理Activity -->
    <activity
            android:name=".ui.activity.ContactManagementActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 联系人详情Activity -->
    <activity
            android:name=".ui.activity.ContactDetailActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 应用管理Activity -->
    <activity
            android:name=".ui.activity.AppManagementActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 显示设置Activity -->
    <activity
            android:name=".ui.activity.DisplaySettingsActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 语音设置Activity -->
    <activity
            android:name=".ui.activity.VoiceSettingsActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 天气设置Activity -->
    <activity
            android:name=".ui.activity.WeatherSettingsActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 提醒管理Activity -->
    <activity
            android:name=".ui.activity.ReminderActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 快捷工具Activity -->
    <activity
            android:name=".ui.activity.ToolsActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 关于Activity -->
    <activity
            android:name=".ui.activity.AboutActivity"
            android:exported="false"
            android:screenOrientation="user"
            android:theme="@style/Theme.FirstSight" tools:ignore="DiscouragedApi"/>

    <!-- 提醒触发和通知按钮 -->
    <receiver
            android:name=".service.reminder.ReminderReceiver"
            android:exported="false" />

    <!-- 开机、时间变更后重新排期 -->
    <receiver
            android:name=".service.reminder.ReminderBootReceiver"
            android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- 提供者用于获取已安装应用列表 -->
    <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
      <meta-data
              android:name="android.support.FILE_PROVIDER_PATHS"
              android:resource="@xml/file_paths" />
    </provider>

    <service android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="true"
      android:label="@string/app_name">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_wechat" />
    </service>
  </application>

</manifest>